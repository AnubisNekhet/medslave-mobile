<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Reels Mode streams 30-second song previews and their cover art -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- a short buzz when the music box is long-pressed -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- installing an update downloaded from GitHub (Updater) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:supportsRtl="false"
        android:theme="@style/Theme.Medslave">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Open with medslave" for .apkg files (file managers and chat apps rarely know their type) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/apkg" />
                <data android:mimeType="application/x-apkg" />
                <data android:mimeType="application/vnd.anki" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/apkg" />
                <data android:mimeType="application/x-apkg" />
                <data android:mimeType="application/vnd.anki" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
        <!-- the package installer's answer to an update (Updater) -->
        <receiver android:name=".InstallReceiver" android:exported="false" />
    </application>
</manifest>
